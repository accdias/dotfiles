# Display the actual date and time
now() {
    echo $(date "+%Y-%m-%d %H:%M:%S") - "$@"
}

# Display 16 ANSI colors
16colors() {
    #Background
    for bg in {40..47} {100..107} 49; do
    # Foreground
        for fg in {30..37} {90..97} 39; do
            # Formatting
            for attr in {0..7}; do
                # Print the result
                printf "\e[%d;%d;%dm ^[%d;%d;%dm \e[0m" $attr $bg $fg $attr $bg $fg
            done
            echo #Newline
        done
    done
}

# Display 256 bit ANSI colors
256colors() {
    for fgbg in 38 48; do # Foreground/Background
        # for color in {0..255}; do # Colors
        x=0
        echo -n " "
        for color in {16..201}; do # Colors
            # Display the color
            printf "\e[%s;5;%sm%0.3d\e[0m" $fgbg $color $color
            # Display 18 colors per lines
            (((x + 1) % 18)) || echo
            (((x + 1) % 6)) || echo -n " "
            ((x++))
        done
        echo # New line
    done
}

# Remove leading and trailing whitespace characters
# See: https://stackoverflow.com/a/3352015/6789321
trim() {
    local var="$*"
    # remove leading whitespace characters
    var="${var#"${var%%[![:space:]]*}"}"
    # remove trailing whitespace characters
    var="${var%"${var##*[![:space:]]}"}"
    echo -n "$var"
}

# Generate strong passwords
genpasswd() {
	local l=$1
       	[ -z $l ] && l=16
      	tr -dc A-Za-z0-9_#@ < /dev/urandom | head -c ${l} | xargs
}

# Set/unset proxy variables
setproxy() {
    if [ "$1" == "-" ]; then
        unset {{HTTP,HTTPS,FTP,SOCKS,NO}_PROXY,{http,https,ftp,socks,no}_proxy}
    else
        export {{HTTP,HTTPS,FTP,SOCKS}_PROXY,{http,https,ftp,socks}_proxy}=socks5h://$1
        export no_proxy='localhost; 172.31.254.*; 192.168.*'
    fi
}

bright() {
    local MAX=$(cat /sys/class/backlight/intel_backlight/max_brightness)
    local LEVEL=$((MAX/4))
    case $1 in
        -r|--reset)
        ;;
        -m|--movie)
            LEVEL=${MAX}
        ;;
        -b|--blank)
            LEVEL=0
        ;;
        *)
        ;;
    esac
    sudo dd status=none of=/sys/class/backlight/intel_backlight/brightness <<< ${LEVEL}
    unset MAX LEVEL
}

listports() {
    local host=${1:-127.0.0.1}
    local ports=$(nmap -p- --min-rate=1000 -T4 ${host} | awk 'BEGIN{FS="/";ORS=","}/^[0-9].*open/{print $1}')
    echo ${ports%,}
}

scanports() {
    local host=${1:-127.0.0.1}
    local ports=$(listports)
    nmap -sC -sV -p${ports} ${host}
}

certdates() {
    local a=$(openssl x509 -in "${1}" -noout -startdate)
    local b=$(openssl x509 -in "${1}" -noout -enddate)
    echo $(date +%Y%m%d --utc -d"${a/not*=}")-$(date +%Y%m%d --utc -d"${b/not*=}")
}

ipr() {
    sudo ip route add ${1} dev vpn0;
}
# background tint for an ssh target, derived from its host key in known_hosts
_ssh_tint() {
  local host port key f sum n
  local -a cfg files lines

  # Obtain effective ssh config
  mapfile -t cfg < <(command ssh -G "$@" 2>/dev/null)

  host=
  port=
  for line in "${cfg[@]}"; do
    case $line in
      hostname\ *) host=${line#hostname } ;;
      port\ *)     port=${line#port } ;;
    esac
  done
  [[ -n $host ]] || return 1
  [[ $port == 22 ]] || host="[$host]:$port"

  # Collect known_hosts files from config
  files=()
  for line in "${cfg[@]}"; do
    case $line in
      userknownhostsfile\ *|globalknownhostsfile\ *)
        read -r -a paths <<< "${line#* }"
        files+=("${paths[@]}")
        ;;
    esac
  done

  # Gather matching key lines
  lines=()
  for f in "${files[@]}"; do
    [[ -r $f ]] || continue
    while IFS= read -r line; do
      lines+=("$line")
    done < <(ssh-keygen -F "$host" -f "$f" 2>/dev/null)
  done

  # Prefer ed25519, otherwise first non-comment key
  key=
  for line in "${lines[@]}"; do
    if [[ $line == *' ssh-ed25519 '* ]]; then
      key=$line
      break
    fi
  done
  if [[ -z $key ]]; then
    for line in "${lines[@]}"; do
      [[ $line == \#* ]] && continue
      key=$line
      break
    done
  fi

  # Extract the key material (third field)
  if [[ -n $key ]]; then
    read -r _ _ key _ <<< "$key"
  fi

  # Unknown host → plain dark-red tint
  if [[ -z $key ]]; then
    printf '#2a1a1a'
    return
  fi

  # Hash the key
  sum=$(printf '%s' "$key" | cksum)
  n=$(( ${sum%% *} % 32 ))

  # HSL → RGB (16 hues × 2 lightness levels) using pure integer arithmetic
  # hp is in [0,6); we work with fixed-point (×1000) to avoid floating point
  local -i hp=$(( (n % 16) * 6000 / 16 ))   # 0‥5999  representing 0‥6
  local -i s=350                             # saturation 0.35
  local -i l=$(( n < 16 ? 120 : 190 ))       # lightness 0.12 or 0.19
  local -i c x m r g b

  # c = (1 - |2l-1|) * s
  c=$(( (1000 - (2*l > 1000 ? 2*l-1000 : 1000-2*l)) * s / 1000 ))

  # x = c * (1 - |hp%2 - 1|)
  local -i hpmod2=$(( hp % 2000 ))
  local -i abs_hp=$(( hpmod2 > 1000 ? hpmod2-1000 : 1000-hpmod2 ))
  x=$(( c * (1000 - abs_hp) / 1000 ))

  m=$(( l - c / 2 ))

  case $(( hp / 1000 )) in
    0) r=$c; g=$x; b=0 ;;
    1) r=$x; g=$c; b=0 ;;
    2) r=0;  g=$c; b=$x ;;
    3) r=0;  g=$x; b=$c ;;
    4) r=$x; g=0;  b=$c ;;
    *) r=$c; g=0;  b=$x ;;
  esac

  printf '#%02x%02x%02x' \
    $(( (r + m) * 255 / 1000 )) \
    $(( (g + m) * 255 / 1000 )) \
    $(( (b + m) * 255 / 1000 ))
}

ssh() {
  local tint rc
  tint=$(_ssh_tint "$@")
  if [[ -n $tint ]]; then
    printf '\e]11;%s\a' "$tint"
  fi
  command ssh "$@"
  rc=$?
  printf '\e]111\a'
  return $rc
}
